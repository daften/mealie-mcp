# Required for every mode
MEALIE_URL=https://your-mealie-instance.example.com

# --- Choose ONE auth mode ---------------------------------------------------

# 1. stdio (default transport): required. Create one in Mealie under Profile → API Tokens.
#    Over HTTP (--transport http), setting this makes every request act as this one Mealie
#    user, with no authentication: anyone who can reach the port has that account's access.
#    Leave it unset over HTTP and each caller sends their own key as a Bearer token.
# MEALIE_API_TOKEN=your-mealie-api-token

# 2. Login form (HTTP only). Users type their Mealie password on a page served by this MCP
#    server, not by Mealie, so only enable it on a server they trust. API keys are then not
#    accepted, and MEALIE_API_TOKEN must be unset. Accepts "true" or "1".
# MEALIE_MCP_PASSWORD_LOGIN=true
#    Encrypts stored Mealie tokens. Required, at least 32 characters, and must stay the same:
#    changing it makes the server refuse to start until the database is reset.
#    Generate with: openssl rand -base64 48
# MCP_TOKEN_KEY=
#    Public origin of this server, with no path. Required off loopback, and must be https.
# MCP_BASE_URL=https://mcp.example.com
#    Where logins are stored. /data in the Docker image, which docker-compose.yml puts on a
#    named volume. Without a persistent volume, logins are lost when the container is replaced.
# MCP_DATA_DIR=./data
#    Number of reverse proxies in front of this server, so rate limits see real client IPs.
# MCP_TRUST_PROXY_HOPS=1
#    Extra redirect_uri prefixes to accept, comma-separated. Loopback addresses and Claude's
#    hosted callbacks are always allowed.
# MCP_ALLOWED_REDIRECT_PREFIXES=https://my-other-client.example.com

# --- Optional tool filtering (fallbacks for --preset / --groups / --read-only) ---
# Presets: minimal, default, full. MCP_PRESET and MCP_GROUPS are mutually exclusive.
# MCP_PRESET=default
# Groups: recipes, recipe-assets, ingredients, organizers, shopping, mealplans
# MCP_GROUPS=recipes,shopping
# MCP_READ_ONLY=true
